{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["company_id", "stand_name"],
  "properties": {
    "company_id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
    "stand_name": {"type": "string", "minLength": 1, "maxLength": 255}
  }
}