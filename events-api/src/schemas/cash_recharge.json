{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_attendee_id", "amount_cents", "idempotency_key"],
  "properties": {
    "event_attendee_id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
    "amount_cents": {"type": "integer", "maximum": 10000000},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 80, "pattern": "^[A-Za-z0-9:_-]+$"}
  }
}
