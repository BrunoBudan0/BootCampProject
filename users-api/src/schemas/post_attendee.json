{
  "title": "PostAttendee",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 255 },
    "email": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}$" },
    "document": { "type": "string", "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$" },
    "password": { "type": "string", "minLength": 8, "maxLength": 128 },
    "birth_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "phone": { "type": "string", "pattern": "^[0-9()+\\- ]{8,20}$" },
    "postal_code": { "type": "string", "pattern": "^\\d{5}-\\d{3}$" }
  },
  "required": ["name", "email", "document", "password", "birth_date"],
  "additionalProperties": false
}
