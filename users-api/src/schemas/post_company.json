{
  "title": "PostCompany",
  "type": "object",
  "properties": {
    "legal_name": { "type": "string", "minLength": 2, "maxLength": 255 },
    "trade_name": { "type": "string", "minLength": 2, "maxLength": 255 },
    "email": { "type": "string", "maxLength": 255, "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
    "document": { "type": "string", "pattern": "^\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2}$" },
    "password": { "type": "string", "minLength": 8, "maxLength": 128 },
    "phone": { "type": "string", "pattern": "^[0-9()+\\- ]{8,20}$" }
  },
  "required": ["legal_name", "trade_name", "email", "document", "password"],
  "additionalProperties": false
}
