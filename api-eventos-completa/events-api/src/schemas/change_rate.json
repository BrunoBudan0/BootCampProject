{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["rate_bps", "reason"],
  "properties": {
    "rate_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"}
  }
}
