{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "location", "fee_rate_bps", "cashback_rate_bps"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "location": {"type": "string", "minLength": 1, "maxLength": 255},
    "description": {"type": ["string", "null"], "maxLength": 2000},
    "fee_rate_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "cashback_rate_bps": {"type": "integer", "minimum": 0, "maximum": 10000}
  }
}
