{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_company_id", "name", "barcode", "price_cents"],
  "properties": {
    "event_company_id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "barcode": {"type": "string", "pattern": "^[0-9A-Za-z-]{1,64}$"},
    "price_cents": {"type": "integer", "minimum": 1},
    "stock": {"type": ["integer", "null"], "minimum": 0}
  }
}
